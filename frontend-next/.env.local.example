# FastAPI backend URL (server-only, no NEXT_PUBLIC_ prefix)
BACKEND_URL=http://localhost:8000

# Shared credentials — must match the backend's BASIC_AUTH_USERNAME/PASSWORD exactly
BASIC_AUTH_USERNAME=
BASIC_AUTH_PASSWORD=

# Random secret for signing the Next.js session cookie (unrelated to the pair above)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
